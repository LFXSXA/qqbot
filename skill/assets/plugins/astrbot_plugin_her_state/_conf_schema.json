{
  "mention_chance": {
    "description": "这次回复主动提起自己状态的概率（0~1）",
    "type": "float",
    "default": 0.35,
    "slider": { "min": 0, "max": 1, "step": 0.05 },
    "hint": "提到「今天累」「心情不太好」这类；太高会显得碎嘴"
  },
  "event_chance": {
    "description": "每条消息触发一桩「生活事件」的概率（0~1）",
    "type": "float",
    "default": 0.05,
    "slider": { "min": 0, "max": 0.3, "step": 0.01 },
    "hint": "生活事件会改她的心情和精力，比如「被领导说了」「吃到好吃的」"
  },
  "mood_swing": {
    "description": "情绪波动幅度（1~3）",
    "type": "float",
    "default": 1.4,
    "slider": { "min": 0.5, "max": 3, "step": 0.1 },
    "hint": "越大越情绪化，越小越稳"
  },
  "decay_hours": {
    "description": "情绪回稳半衰期（小时）",
    "type": "int",
    "default": 8,
    "slider": { "min": 1, "max": 48, "step": 1 }
  },
  "energy_floor": {
    "description": "精力最低能掉到多少",
    "type": "int",
    "default": 15,
    "slider": { "min": 5, "max": 60, "step": 5 }
  }
}
